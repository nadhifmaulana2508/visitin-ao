# ============================================
# VISITIN-AO ENVIRONMENT CONFIGURATION
# ============================================

# --- Database: DPK (Data Prospek & Kunjungan) ---
# Database utama untuk menyimpan data prospek, kunjungan, mapping, dll.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=dpk
DB_PORT=3306

# --- Database: SIMPEG (Data Kepegawaian) ---
# Database read-only untuk mengambil data pegawai aktif.
# Server & port sama, hanya beda nama database.
SIMPEG_DB_HOST=localhost
SIMPEG_DB_USER=root
SIMPEG_DB_PASS=
SIMPEG_DB_NAME=masq2971_simpeg_dummy
SIMPEG_DB_PORT=3306

# --- SSO (Non-aktif, pakai dummy login dulu) ---
# SIMPEG_BASE_URL=https://apisso.bkkjateng.co.id
# APP_NAME=visitin-ao

# --- Cookie Auth ---
COOKIE_NAME=sso_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_PATH=/

# --- Upload ---
UPLOAD_DIR=uploads/
MAX_UPLOAD_SIZE=5242880
