# ============================================
# VISITIN-AO ENVIRONMENT CONFIGURATION
# ============================================

# --- Database: DPK (Data Prospek & Kunjungan) ---
# Database utama untuk menyimpan data prospek, kunjungan, mapping, dll.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=dpk
DB_PORT=3306

# --- Database: SIMPEG (Data Kepegawaian) ---
# Database read-only untuk mengambil data pegawai aktif.
# Server & port sama, hanya beda nama database.
SIMPEG_DB_HOST=localhost
SIMPEG_DB_USER=root
SIMPEG_DB_PASS=
SIMPEG_DB_NAME=masq2971_simpeg_dummy
SIMPEG_DB_PORT=3306

# --- SSO ---
SSO_BASE_URL=https://apisso.bkkjateng.co.id
SSO_APP=ims
HTTP_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10
HTTP_SSL_VERIFY=true

# --- Cookie Auth ---
COOKIE_NAME=sso_token
COOKIE_DOMAIN=.bkkjateng.co.id
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
COOKIE_PATH=/

# --- Upload ---
UPLOAD_DIR=uploads/
MAX_UPLOAD_SIZE=5242880
